<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>io.github.lauto5</groupId>
	<artifactId>rate-limit</artifactId>
	<version>1.0.0</version>
	<packaging>pom</packaging>
	<name>rate limit</name>
	<description>Lightweight extensible rate limiting library for Java built on hexagonal architecture.</description>
	<url>https://github.com/Lauto5/Rate-Limit</url>

	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://opensource.org/licenses/MIT</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>Lauto5</id>
			<name>Lauto5</name>
			<email>169007709+Lauto5@users.noreply.github.com</email>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:git@github.com:Lauto5/Rate-Limit.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/Lauto5/Rate-Limit.git</developerConnection>
		<url>https://github.com/Lauto5/Rate-Limit</url>
	</scm>

	<modules>
		<module>rate-limit-core</module>
		<module>rate-limit-inmemory</module>
		<module>rate-limit-redis</module>
	</modules>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<!-- Compilacion: todo el proyecto (main y tests) compila contra la API de
		     Java 8, generando bytecode portable a Java 8+. -->
		<maven.compiler.release>8</maven.compiler.release>

		<!-- Version de JDK requerida para compilar con el flag release (JDK 9+) -->
		<required.java.version>[9,)</required.java.version>

		<!-- Versiones -->
		<testcontainers.version>1.19.8</testcontainers.version>
		<junit.jupiter.version>5.10.2</junit.jupiter.version>
		<lettuce.version>6.3.2.RELEASE</lettuce.version>
		<commons.pool2.version>2.12.0</commons.pool2.version>
		<slf4j.version>2.0.18</slf4j.version>

		<!-- Versiones de plugins -->
		<maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
		<maven.surefire.plugin.version>3.5.3</maven.surefire.plugin.version>
		<maven.enforcer.plugin.version>3.5.0</maven.enforcer.plugin.version>
		<jacoco.plugin.version>0.8.12</jacoco.plugin.version>
		<exec.plugin.version>3.5.0</exec.plugin.version>
		<maven.source.plugin.version>3.3.1</maven.source.plugin.version>
		<maven.javadoc.plugin.version>3.12.0</maven.javadoc.plugin.version>
		<maven.gpg.plugin.version>3.2.8</maven.gpg.plugin.version>
		<central.publishing.plugin.version>0.11.0</central.publishing.plugin.version>
		<!-- Solo publican con '-Ppublish'; por defecto nunca suben nada. -->
		<central.autoPublish>false</central.autoPublish>
		<central.skipPublishing>false</central.skipPublishing>
	</properties>

	<dependencyManagement>
		<dependencies>

			<!-- Modulos del proyecto -->
			<dependency>
				<groupId>io.github.lauto5</groupId>
				<artifactId>rate-limit-core</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.github.lauto5</groupId>
				<artifactId>rate-limit-inmemory</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- JUnit 5 Engine & API -->
			<dependency>
				<groupId>org.junit.jupiter</groupId>
				<artifactId>junit-jupiter-api</artifactId>
				<version>${junit.jupiter.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.junit.jupiter</groupId>
				<artifactId>junit-jupiter-engine</artifactId>
				<version>${junit.jupiter.version}</version>
				<scope>test</scope>
			</dependency>

			<!-- Cliente Redis (Lettuce) -->
			<dependency>
				<groupId>io.lettuce</groupId>
				<artifactId>lettuce-core</artifactId>
				<version>${lettuce.version}</version>
			</dependency>

			<!-- Pooling de conexiones Redis -->
			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-pool2</artifactId>
				<version>${commons.pool2.version}</version>
			</dependency>

			<!-- Testcontainers Core -->
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers</artifactId>
				<version>${testcontainers.version}</version>
				<scope>test</scope>
			</dependency>

			<!-- Testcontainers JUnit 5 Extension -->
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>junit-jupiter</artifactId>
				<version>${testcontainers.version}</version>
				<scope>test</scope>
			</dependency>

			<!-- SLF4J API (requerido por Lettuce en rate-limit-redis) -->
			<dependency>
				<groupId>org.slf4j</groupId>
				<artifactId>slf4j-api</artifactId>
				<version>${slf4j.version}</version>
			</dependency>

		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>

				<!-- Compila contra la API de Java 8 (main y tests) -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>${maven.compiler.plugin.version}</version>
					<configuration>
						<release>${maven.compiler.release}</release>
						<parameters>true</parameters>
					</configuration>
				</plugin>

				<!-- Ejecutar un main desde terminal:
				       mvn compile exec:java -Dexec.mainClass="..." -Dexec.args="..." -->
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>exec-maven-plugin</artifactId>
					<version>${exec.plugin.version}</version>
				</plugin>

				<!-- Sources JAR por modulo publicable (requisito de Central) -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-source-plugin</artifactId>
					<version>${maven.source.plugin.version}</version>
				</plugin>

				<!-- Javadoc JAR por modulo publicable (requisito de Central) -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-javadoc-plugin</artifactId>
					<version>${maven.javadoc.plugin.version}</version>
				</plugin>

				<!-- Firma GPG de artifacts (perfil 'publish') -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-gpg-plugin</artifactId>
					<version>${maven.gpg.plugin.version}</version>
				</plugin>

				<!-- Publicacion en Maven Central / Central Portal (perfil 'publish') -->
				<plugin>
					<groupId>org.sonatype.central</groupId>
					<artifactId>central-publishing-maven-plugin</artifactId>
					<version>${central.publishing.plugin.version}</version>
				</plugin>

			</plugins>
		</pluginManagement>

		<plugins>

			<!-- Pruebas: salida limpia en terminal + reintento contra flaky -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>${maven.surefire.plugin.version}</version>
				<configuration>
					<!-- Mantiene la consola limpia; el System.out de los tests
					     va a target/surefire-reports/ -->
					<redirectTestOutputToFile>true</redirectTestOutputToFile>
					<!-- Reintenta 1 vez si un test falla (tests flaky) -->
					<rerunFailingTestsCount>1</rerunFailingTestsCount>
					<!-- Cierra los stack traces largos en el resumen -->
					<trimStackTrace>true</trimStackTrace>
				</configuration>
			</plugin>

			<!-- Fija versiones de Java y Maven al construir -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>${maven.enforcer.plugin.version}</version>
				<executions>
					<execution>
						<id>enforce-versions</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireJavaVersion>
									<version>${required.java.version}</version>
								</requireJavaVersion>
								<requireMavenVersion>
									<version>[3.9.0,)</version>
								</requireMavenVersion>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Cobertura: 'mvn verify' genera target/site/jacoco/index.html -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.plugin.version}</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

		</plugins>
	</build>

	<profiles>
		<profile>
			<id>publish</id>
			<!-- Pipeline de release: 'mvn -Ppublish clean deploy' ejecuta todo sin
			     pasos manuales intermedios (compile, test, sources, javadoc, firma
			     GPG y bundle/subida a Central). Por defecto no sube ni publica nada:
			     autoPublish=false: el alta final se confirma en Central Portal. -->
			<build>
				<plugins>

					<!-- Firma criptografica de cada artifact (requisito de Central).
					     Requiere una clave GPG local; los secretos viven en ~/.m2/settings.xml
					     o como -Dgpg.keyname/-Dgpg.passphrase, nunca en el repositorio. -->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
					</plugin>

					<!-- 'mvn deploy' genera central-bundle.zip con jar/sources/javadoc/firmas/
					     checksums y lo sube al Central Portal. Credenciales: server 'central'
					     en settings.xml (user token de central.sonatype.com). -->
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central</publishingServerId>
							<autoPublish>${central.autoPublish}</autoPublish>
							<waitUntil>validated</waitUntil>
							<skipPublishing>${central.skipPublishing}</skipPublishing>
						</configuration>
					</plugin>

				</plugins>
			</build>
		</profile>
	</profiles>

</project>