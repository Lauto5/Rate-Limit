<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.lauto5.examples</groupId>
		<artifactId>rate-limit-examples</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>core-inmemory</artifactId>
	<packaging>jar</packaging>
	<name>rate limit example - core + inmemory</name>
	<description>Ejemplo externo: usa rate-limit-core con la persistencia en memoria.</description>

	<dependencies>

		<dependency>
			<groupId>io.github.lauto5</groupId>
			<artifactId>rate-limit-core</artifactId>
		</dependency>

		<dependency>
			<groupId>io.github.lauto5</groupId>
			<artifactId>rate-limit-inmemory</artifactId>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<configuration>
					<mainClass>io.github.lauto5.example.InMemoryExample</mainClass>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>